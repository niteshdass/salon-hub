# SalonHub — production environment template.
# Copy to /var/www/salonhub/backend/.env on the server, fill every value
# marked CHANGE-ME, then run: php artisan key:generate && php artisan config:cache

APP_NAME=SalonHub
APP_ENV=production
APP_KEY=                      # CHANGE-ME: php artisan key:generate writes this
APP_DEBUG=false               # never true in production: leaks stack traces and env
APP_URL=https://app.salonhub.com
# The apex salons get a subdomain under. Read by config/app.php AND
# config/cors.php, so it decides three things at once: which host each new
# salon's primary domain row is minted on, which origins CORS trusts, and —
# through that domain row — which tenant a Host header resolves to. Changing
# it after salons exist orphans their already-minted <slug>.<old apex> rows.
APP_DOMAIN=salonhub.com
FRONTEND_URL=https://app.salonhub.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily               # daily, not single: single grows unbounded on a VPS
LOG_LEVEL=warning             # debug in production writes customer data to disk

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salonhub
DB_USERNAME=salonhub
DB_PASSWORD=                  # CHANGE-ME

# Redis carries queue and cache. Requires the phpredis extension.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis        # 4 Mailables + the reminder job are ShouldQueue: no worker, no mail/reminders
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=public        # logos, covers and gallery images; needs `php artisan storage:link`

# Transactional email. A real SMTP relay — MAIL_MAILER=log discards everything.
MAIL_MAILER=smtp
MAIL_HOST=                    # CHANGE-ME
MAIL_PORT=587
MAIL_USERNAME=                # CHANGE-ME
MAIL_PASSWORD=                # CHANGE-ME
MAIL_SCHEME=                  # optional: leave blank to auto-select from MAIL_PORT (587->smtp+STARTTLS, 465->smtps). Symfony only accepts smtp or smtps.
MAIL_FROM_ADDRESS="bookings@salonhub.com"
MAIL_FROM_NAME="SalonHub"

# Where the marketing contact form delivers, and the address published on the
# legal pages. MUST be a real, monitored mailbox before launch — the privacy
# page names it as the contact for data-subject requests and the refund page as
# the dispute escalation point, so an address nobody reads is worse than none.
# Set the frontend's VITE_CONTACT_EMAIL to the same value.
CONTACT_EMAIL="support@salonhub.com"

# Origins allowed to call the API. Salon subdomains match by pattern from
# APP_DOMAIN and need no entry here.
CORS_ALLOWED_ORIGINS=https://app.salonhub.com,https://salonhub.com

# Platform Twilio account for reminders. A salon may connect its own in
# Settings; these carry everyone else. Empty = reminders log instead of send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Error monitoring (Task 13). Empty DSN = disabled entirely (nothing is
# sent, `sentry:test` has nothing to reach). config/sentry.php hardcodes
# send_default_pii off, max_request_body_size to 'none' and the cache
# breadcrumb/span off regardless of what's set here — none of that is
# controllable via env, by design, so filling in the DSN below cannot
# accidentally widen what leaves the server.
SENTRY_LARAVEL_DSN=
# 0 = performance tracing off. This task (Task 13) is error reporting only;
# turning tracing on is a deliberate follow-up, not a byproduct of setting a
# DSN, because tracing spans (SQL, outbound HTTP, views) haven't had the
# same PII review as the error-reporting path above. A non-zero value here
# with no review behind it would be silent, unreviewed data collection —
# an honest 0 says so.
SENTRY_TRACES_SAMPLE_RATE=0
