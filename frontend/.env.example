# Frontend build-time configuration.
#
# Vite inlines every VITE_* variable into the bundle at BUILD time, so these
# are baked into the artifact `deploy.sh` copies to backend/public/app — there
# is no runtime override. Rebuild after changing one.
#
# Copy to `.env.production` (or export the variables in the build environment)
# before running the production build.

# The apex that salons get their subdomain under. MUST equal the backend's
# APP_DOMAIN, which is the same value config('app.domain') and
# config/cors.php's allowed_origins_patterns read.
#
# This is load-bearing, not cosmetic. frontend/src/lib/tenantHost.js reads it
# to decide whether the current Host names a salon. If it does not match the
# domain the site is actually served on, resolveSlugFromHost() returns null for
# every real salon host and NOTHING ERRORS — it is silently the wrong page:
#
#   - router/index.js renders LandingView instead of SalonSiteView, so every
#     salon's booking site serves the Glowhub marketing page.
#   - the signed-in-member branch inverts and bounces staff on a salon
#     subdomain to /dashboard.
#   - SubdomainBanner tells the owner to share a host that does not exist.
#
# It works with this unset only because the fallback in tenantHost.js and the
# fallback in backend config/app.php happen to be the same literal. A staging
# environment, a rename, or a second deployment breaks the primary
# customer-facing surface with no error anywhere. deploy.sh exports it.
VITE_APP_DOMAIN=glowhub.com

# Base URL for API calls. Genuinely optional: both production vhosts serve the
# SPA and the API from one origin, so the same-origin '/api' default in
# src/lib/api.js is correct and needs no CORS. Set it only when the API lives
# on a different origin from the app.
# VITE_API_URL=https://app.glowhub.com/api

# The address published on the marketing and legal pages. MUST equal the
# backend's CONTACT_EMAIL, which config('mail.contact_address') reads and the
# contact form delivers to — the pages would otherwise invite people to write to
# a mailbox that receives nothing.
#
# Keep it a role address on the product domain, not a personal mailbox: the
# privacy page names it as the contact for data-subject requests about third
# parties' names, phones, emails and booking notes, and the refund page as the
# escalation point for money disputes. Those need retention, delegation and
# continuity a personal account cannot give.
VITE_CONTACT_EMAIL=support@glowhub.com
